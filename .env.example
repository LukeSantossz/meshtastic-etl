# Copie este arquivo para ".env" e ajuste os valores conforme seu ambiente local.
# Nunca commite o arquivo ".env" real (ele contém credenciais).

# --- MongoDB (origem dos dados brutos dos sensores) ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=iot
# Nome da coleção usado neste PI; a coleção oficial da turma pode se chamar "sensores".
MONGO_COLLECTION=pacotes_brutos
# Coleção para onde vão os documentos que falham na validação (quarentena do Lucas).
MONGO_QUARANTINE_COLLECTION=lucas_quarentena

# --- MariaDB (destino dos dados tratados/agregados) ---
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=lucas
MARIADB_PASSWORD=changeme
MARIADB_DATABASE=fatec_iot

# --- Redis (cache / controle de estado do pipeline) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Deixe em branco se o Redis local não exigir senha.
REDIS_PASSWORD=

# --- Configurações gerais do pipeline ---
# Prefixo usado em nomes de tabelas/coleções/chaves para isolar os dados do Lucas.
PREFIX=lucas
# Intervalo (em segundos) entre cada ciclo de leitura do pipeline.
POLL_INTERVAL_SECONDS=5
# Limite (em segundos) de silêncio de um nó para ser considerado um "buraco" de dados.
GAP_THRESHOLD_SECONDS=900
# Quantidade de documentos processados por lote.
BATCH_SIZE=100
